<UserControl x:Class="LogReader.Views.QueryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogReader.ViewModels">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source Section -->
        <GroupBox Grid.Row="0" Header="來源" Margin="0,0,0,6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Local Mode -->
                <RadioButton Grid.Row="0" Grid.Column="0"
                             Content="本機路徑" VerticalAlignment="Center"
                             IsChecked="{Binding IsRemoteMode, Converter={StaticResource InverseBoolConverter}}"
                             Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" Padding="4,3"
                         IsEnabled="{Binding IsLocalMode}"
                         Margin="0,0,6,4"/>
                <Button Grid.Row="0" Grid.Column="2"
                        Content="瀏覽..." Width="60" Height="28"
                        IsEnabled="{Binding IsLocalMode}"
                        Command="{Binding BrowsePathCommand}"
                        Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="(支援 .log / .txt)"
                           VerticalAlignment="Center"
                           Foreground="Gray" FontSize="11"
                           Margin="8,0,0,4"/>

                <!-- Remote Mode -->
                <RadioButton Grid.Row="1" Grid.Column="0"
                             Content="遠端連線" VerticalAlignment="Center"
                             IsChecked="{Binding IsRemoteMode}"
                             Margin="0,0,8,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding Connections}"
                          SelectedItem="{Binding SelectedConnection}"
                          Height="28"
                          IsEnabled="{Binding IsRemoteMode}"
                          Margin="0,0,6,0"/>
                <Button Grid.Row="1" Grid.Column="2"
                        Content="下載遠端 Log" Width="100" Height="28"
                        IsEnabled="{Binding IsRemoteMode}"
                        Command="{Binding DownloadRemoteCommand}"
                        Background="#0078D7" Foreground="White"
                        Margin="0,0,6,0"/>
                <Button Grid.Row="1" Grid.Column="3"
                        Content="取消下載" Width="80" Height="28"
                        Command="{Binding CancelDownloadCommand}"
                        IsEnabled="{Binding IsDownloading}"/>
            </Grid>
        </GroupBox>

        <!-- Filter Section -->
        <GroupBox Grid.Row="1" Header="篩選條件" Margin="0,0,0,6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Date Range -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="建立日期 從：" VerticalAlignment="Center"
                           Margin="0,0,6,6"/>
                <DatePicker Grid.Row="0" Grid.Column="1"
                            SelectedDate="{Binding StartDate}"
                            Height="28" Margin="0,0,10,6"/>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="至：" VerticalAlignment="Center"
                           Margin="0,0,6,6"/>
                <DatePicker Grid.Row="0" Grid.Column="3"
                            SelectedDate="{Binding EndDate}"
                            Height="28" Margin="0,0,0,6"/>

                <!-- Keywords -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="關鍵字：" VerticalAlignment="Top"
                           Margin="0,3,6,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                         Text="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}"
                         Height="70" Padding="4,4"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="每行一個關鍵字"/>

                <!-- Filter Mode -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="過濾模式：" VerticalAlignment="Center"
                           Margin="0,6,6,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                            Orientation="Horizontal" Margin="0,6,0,0">
                    <RadioButton Content="包含任一關鍵字 (OR)"
                                 IsChecked="{Binding IsMatchAll, Converter={StaticResource InverseBoolConverter}}"
                                 Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton Content="包含所有關鍵字 (AND)"
                                 IsChecked="{Binding IsMatchAll}"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="▶ 開始查詢" Width="100" Height="32"
                    Command="{Binding StartSearchCommand}"
                    Background="#107C10" Foreground="White" FontWeight="SemiBold"
                    Margin="0,0,8,0"/>
            <Button Content="✕ 取消查詢" Width="90" Height="32"
                    Command="{Binding CancelSearchCommand}"
                    IsEnabled="{Binding IsSearching}"
                    Margin="0,0,16,0"/>
            <Button Content="★ 加入最愛" Width="90" Height="32"
                    Command="{Binding AddToFavoritesCommand}"
                    Margin="0,0,8,0"/>
            <Button Content="↓ 匯出 TXT" Width="90" Height="32"
                    Command="{Binding ExportCommand}"
                    Margin="0,0,0,0"/>
        </StackPanel>

        <!-- ProgressBar -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Height="18"
                         Value="{Binding Progress}"
                         Minimum="0" Maximum="100"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding ProgressText}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" FontSize="11" Foreground="Gray"/>
        </Grid>

        <!-- Re-Filter Section -->
        <GroupBox Grid.Row="4" Header="二次篩選" Margin="0,0,0,6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="再過濾：" VerticalAlignment="Top"
                           Margin="0,3,6,0"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding ReFilterKeywords, UpdateSourceTrigger=PropertyChanged}"
                         Height="50" Padding="4,4"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="每行一個關鍵字"/>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,8,0" VerticalAlignment="Top">
                    <RadioButton Content="包含任一"
                                 IsChecked="{Binding IsReFilterMatchAll, Converter={StaticResource InverseBoolConverter}}"
                                 Margin="0,4,0,4"/>
                    <RadioButton Content="包含所有"
                                 IsChecked="{Binding IsReFilterMatchAll}"/>
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="3"
                        Content="執行二次篩選" Width="100" Height="32"
                        VerticalAlignment="Top"
                        Command="{Binding ReFilterCommand}"
                        Background="#5C2D91" Foreground="White"/>
            </Grid>
        </GroupBox>

        <!-- Results DataGrid -->
        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding Results}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F5F5F5"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="檔案名稱" Binding="{Binding FileName}" Width="180"/>
                <DataGridTextColumn Header="行號" Binding="{Binding LineNumber}" Width="60"/>
                <DataGridTextColumn Header="內容" Binding="{Binding Content}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="6" Background="#F0F0F0" Padding="6,3">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#333"/>
        </Border>
    </Grid>
</UserControl>
