<Window x:Class="LogReader.Views.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="我的最愛" Height="400" Width="580"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="FavListBox" Grid.Row="0" Margin="0,0,0,8"
                 SelectionChanged="FavListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Foreground="Gray" FontSize="11">
                            <Run Text="{Binding Keywords, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="套用此查詢" Width="90" Height="28" Margin="0,0,8,0"
                    Click="ApplyButton_Click" IsDefault="True"/>
            <Button Content="刪除選取" Width="80" Height="28" Margin="0,0,8,0"
                    Click="DeleteButton_Click"/>
            <Button Content="關閉" Width="70" Height="28"
                    Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
