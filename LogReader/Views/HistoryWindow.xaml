<Window x:Class="LogReader.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查詢歷史紀錄" Height="400" Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="HistoryListBox" Grid.Row="0"
                 Margin="0,0,0,8"
                 SelectionChanged="HistoryListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Padding="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="使用此查詢" Width="90" Height="28" Margin="0,0,8,0"
                    Click="UseButton_Click" IsDefault="True"/>
            <Button Content="刪除選取" Width="80" Height="28" Margin="0,0,8,0"
                    Click="DeleteButton_Click"/>
            <Button Content="清除全部" Width="80" Height="28" Margin="0,0,8,0"
                    Click="ClearAllButton_Click"/>
            <Button Content="關閉" Width="70" Height="28"
                    Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
