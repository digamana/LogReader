<Window x:Class="LogReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LogReader.Views"
        xmlns:vm="clr-namespace:LogReader.ViewModels"
        Title="Log Reader" Height="780" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Background="#F3F3F3" Padding="4,2">
            <Button Content="🔌 連線管理"
                    Command="{Binding OpenConnectionManagerCommand}"
                    Padding="10,4" Margin="0,0,4,0"
                    ToolTip="管理遠端 SSH/SFTP 連線"/>
            <Separator/>
            <Button Content="📋 歷史紀錄"
                    Command="{Binding OpenHistoryCommand}"
                    Padding="10,4" Margin="0,0,4,0"
                    ToolTip="查看最近 10 筆查詢紀錄"/>
            <Button Content="⭐ 我的最愛"
                    Command="{Binding OpenFavoritesCommand}"
                    Padding="10,4" Margin="0,0,4,0"
                    ToolTip="管理常用查詢"/>
            <Separator/>
            <Button Content="＋ 新增查詢分頁"
                    Command="{Binding AddTabCommand}"
                    Padding="10,4"
                    Background="#E8F5E9"
                    ToolTip="開啟新的查詢分頁"/>
        </ToolBar>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TabName}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="✕" Width="16" Height="16"
                                FontSize="9" Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.CloseTabCommand,
                                          RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="關閉此分頁"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <views:QueryTabView DataContext="{Binding}"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>
